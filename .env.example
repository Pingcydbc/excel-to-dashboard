# ====================================================
# V-COP CMTC Dashboard Environment Configuration
# ====================================================

# 1. Database Connection (PostgreSQL)
# สำหรับใช้งานบน Docker ในเครื่อง Server (ค่าเริ่มต้น):
DATABASE_URL="postgresql://postgres:password123@postgres-db:5432/student_dashboard?schema=public"

# สำหรับ Standalone Localhost (รัน npm run dev บนเครื่องโดยตรง):
# DATABASE_URL="postgresql://postgres:password123@localhost:5432/student_dashboard?schema=public"

# 2. Database User & Password สำหรับ Docker Service
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=student_dashboard

# 3. Authentication Secret for Admin Panel
JWT_SECRET="super_secret_jwt_key_2026_excel_to_dashboard"

# 4. Public App URL
NEXT_PUBLIC_APP_URL="https://v-cop.cmtc.ac.th"

# 5. Default Admin Credentials (สามารถเปลี่ยนรหัสผ่านได้ที่นี่)
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="admincmtcvcop123"
