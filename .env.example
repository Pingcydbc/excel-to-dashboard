# ====================================================
# V-COP CMTC Dashboard Environment Configuration
# ====================================================

# 1. Database Connection (PostgreSQL)
# สำหรับ Docker Compose ในเครื่อง Server:
DATABASE_URL="postgresql://postgres:password123@postgres-db:5432/student_dashboard?schema=public"

# สำหรับ Standalone Localhost:
# DATABASE_URL="postgresql://postgres:password123@localhost:5432/student_dashboard?schema=public"

# 2. Authentication Secret for Admin Panel
JWT_SECRET="super_secret_jwt_key_2026_excel_to_dashboard"

# 3. Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Default Admin Credentials (สามารถเปลี่ยนรหัสผ่านได้ที่นี่)
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="admincmtcvcop123"
